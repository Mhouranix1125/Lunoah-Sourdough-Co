# systemd service for the Lunoah website on a Linux server.
# deploy/install.sh puts this in /etc/systemd/system/lunoah.service and starts it.
# PocketBase gets a free HTTPS certificate for the domain automatically.
[Unit]
Description=Lunoah Sourdough Co. website
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lunoah
EnvironmentFile=-/opt/lunoah/stripe.env
ExecStart=/opt/lunoah/pocketbase serve lunoahsourdoughco.com www.lunoahsourdoughco.com --dir=/opt/lunoah/pb_data --migrationsDir=/opt/lunoah/site/pb_migrations --publicDir=/opt/lunoah/site/pb_public --hooksDir=/opt/lunoah/site/pb_hooks
Restart=always
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
